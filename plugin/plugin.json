{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "mangsang",
  "version": "2.6.0",
  "engines": {
    "python": ">=3.11"
  },
  "records": [
    "mangsang/",
    ".mangsang/"
  ],
  "description": "Stores relations between anchors, signed by the person who judged them, a delegation citing their recorded words, or the agent itself with its reason; reports what went stale.",
  "reads": {
    "file": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "lookup",
      "{path}",
      "--target",
      "{target}"
    ],
    "decision": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "cq",
      "--target",
      "{target}"
    ],
    "note": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "lookup",
      "{path}",
      "--brief",
      "--target",
      "{target}"
    ],
    "map": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "concept",
      "list",
      "--brief",
      "--target",
      "{target}"
    ]
  }
}
