  "resolutions": {
    "building a slice from a goal or plan": {
      "use": "chongdae:run",
      "note": "judge's proposal, applied verbatim by the mangsang setup session under the owner's delegated setup; no person read it",
      "reviewed": false
    },
    "disputing, testing or trying a built slice": {
      "use": "hacheong:newbie",
      "note": "judge's proposal, applied verbatim by the mangsang environment-refresh session under the owner's authorized maintenance; no person read it",
      "reviewed": false
    },
    "reviewing a change before merge": {
      "order": [
        "plugin:chongdae",
        "dwitbuk:review"
      ],
      "note": "judge's proposal, applied verbatim by the mangsang setup session under the owner's delegated setup; no person read it",
      "reviewed": false
    },
    "asking what happened or what is open": {
      "order": [
        "chongdae:run",
        "dwitbuk:review",
        "jokbo:read"
      ],
      "accept": "Answering 'what is open' reads `follow` and existing reviews only; a new hand review and its commit happen inside a chongdae session run, on the person's word",
      "note": "judge's two proposals (this order; this accept) combined unchanged by the mangsang setup session under delegated setup; no person read it",
      "reviewed": false
    },
    "bringing a decision to the person": {
      "order": [
        "mangsang:operate",
        "chongdae:run",
        "dwitbuk:review"
      ],
      "note": "judge proposed `use chongdae:run` over dwitbuk:review and `use mangsang:operate` over chongdae:run; the mangsang setup session merged the two into this precedence; no person read it",
