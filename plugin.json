{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "mangsang",
  "version": "1.14.0",
  "engines": {
    "python": ">=3.9"
  },
  "records": [
    "mangsang/",
    ".mangsang/"
  ],
  "description": "The coherence manager for every artifact in a project — plan, code, tests.",
  "reads": {
    "file": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "lookup",
      "{path}",
      "--target",
      "{target}"
    ],
    "decision": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "cq",
      "--target",
      "{target}"
    ]
  }
}
